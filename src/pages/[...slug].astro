---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { parseHomeCopy } from "../lib/home-copy";
import { HOME_AND_LEGAL_PAGES, LANGUAGES } from "../lib/site";

// services, about and contact stay in content/ as the copy of the home sections; they build no page.
export async function getStaticPaths() {
  const entriesByLanguage = await Promise.all(LANGUAGES.map(async (language) => ({ language, entries: await getCollection(language) })));
  return entriesByLanguage.flatMap(({ language, entries }) => {
    const byPage = (wanted: string) => {
      const found = entries.find((entry) => entry.data.page === wanted);
      if (!found) throw new Error(`content/${language}/${wanted}.md is missing`);
      return found;
    };
    return entries
      .filter((entry) => HOME_AND_LEGAL_PAGES.includes(entry.data.page))
      .map((entry) => ({
        params: { slug: entry.data.path.replace(/^\/|\/$/g, "") || undefined },
        props: {
          entry,
          language,
          homeCopy: entry.data.page === "home" ? parseHomeCopy({ home: entry, services: byPage("services"), about: byPage("about"), contact: byPage("contact") }) : null,
        },
      }));
  });
}

const { entry, language, homeCopy } = Astro.props;
const { Content } = await render(entry);
---

<Base language={language} page={entry.data.page} title={entry.data.title} description={entry.data.description} mainClass={homeCopy ? undefined : "legal-page"}>
  {homeCopy ? <Home copy={homeCopy} /> : <div class="wrap detail-wrap"><Content /></div>}
</Base>
