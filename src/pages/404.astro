---
import Base from "../layouts/Base.astro";
---

<Base language="en" page="home" standalone title="Page not found | Prototype" description="The page you asked for does not exist." mainClass="legal-page">
  <div class="wrap detail-wrap">
    <h1>Page not found</h1>
    <p>The address you followed does not lead anywhere on this site. It may have moved, or the link may have a typo.</p>
    <p class="action contact-actions">
      <a href="/">Back to the home page</a>
      <a class="secondary-action" href="/es/" lang="es" hreflang="es">Ir al inicio en español</a>
    </p>
  </div>
</Base>
