---
import { getEntry } from "astro:content";

const homeEntry = await getEntry("en", "home");
if (!homeEntry) {
  throw new Error("content/en/home.md is missing");
}
const { title, description } = homeEntry.data;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <h1>{title}</h1>
  </body>
</html>
