---
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import { GRID_OVERLAY_SCRIPT } from "../lib/grid-overlay";
import { LEGAL_NAME, OG_LOCALES, SITE_NAME, SKIP_LINK_LABELS, SWITCH_LABELS, getChrome } from "../lib/site";
import type { Language } from "../lib/site";

interface Props {
  language: Language;
  page: string;
  title: string;
  description: string;
  mainClass?: string;
  // A page that is not a version of the home (the 404) must not claim the home's URL or its hreflang pair.
  standalone?: boolean;
}

const { language, page, title, description, mainClass, standalone = false } = Astro.props;
const chrome = await getChrome(language, page, Astro.site!);
const otherLocale = OG_LOCALES[chrome.switchTarget.language];
// The ?grid review overlay is only built when PROTO_GRID=1, so a normal build (the deploy) never carries it.
const withGridOverlay = page === "home" && process.env.PROTO_GRID === "1";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!standalone && <meta property="og:url" content={chrome.ogUrl} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALES[language]} />
    {!standalone && <meta property="og:locale:alternate" content={otherLocale} />}
    {!standalone && chrome.alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{SKIP_LINK_LABELS[language]}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={chrome.homeHref}><span class="brand-mark"><Mark /></span>{SITE_NAME}</a>
        <div class="header-actions">
          <nav class="site-nav">
            {chrome.nav.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
          <div class="language-switch">
            <span aria-current="true">{SWITCH_LABELS[language]}</span>
            <a lang={chrome.switchTarget.language} hreflang={chrome.switchTarget.language} href={chrome.switchTarget.href}>{chrome.switchTarget.label}</a>
          </div>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1" class={mainClass}><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-links">
          {chrome.footer.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <small>{`© ${new Date().getFullYear()} ${LEGAL_NAME}`}</small>
      </div>
    </footer>
    {withGridOverlay && <script is:inline type="module" set:html={GRID_OVERLAY_SCRIPT} />}
    <script>
      import "../scripts/wheel-easing";
      import "../scripts/nav-current";
    </script>
  </body>
</html>
